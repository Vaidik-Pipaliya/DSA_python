   "source": [
    "def binary(nums,low,high,):\n",
    "    target = 2\n",
    "    if low>high:\n",
    "        return -1\n",
    "    mid = (high+low)//2\n",
    "    if nums[mid] == target:\n",
    "        return mid\n",
    "    elif nums[mid]<target:\n",
    "        binary(nums,mid+1,high)\n",
    "    else:\n",
    "        binary(nums,low,mid-1)\n"
   ]
  }
 ],
